//@version=6
indicator("Options levels", overlay = true, max_lines_count = 300, max_labels_count = 300, max_boxes_count = 150)

// Each level is drawn as a line that STARTS when that level first appeared and runs to the current candle,
// ending in a small block that shows the label and price. Nothing extends to infinity.
//
// Paste your levels into the setting below, one per line:
//   price, label, type, first seen (Eastern Time), zone low, zone high, score, family
// Only price and label are required. Zone low and high are for bands: those are drawn as a shaded box.
// Score (0 to 100) is the app's importance score; family is gex, oi, vol, move, charm, vanna, dex, new, flip or mine.
// Charm, vanna and dealer delta are MODELED dealer flows (estimates). New positions = open interest added since the previous session.
// Each family has its own settings group: show it or not, how many to draw, color, width and line style.
// "Max levels" keeps the highest-scoring levels of that family (nearest to price first when there is no score).
// First seen example: 2026-10-16 09:50 . The app also writes a line  // @start 2026-10-16 09:40  used for levels without their own time.
// Lines starting with // are ignored. Do not use commas inside a label.
// The levels are ESTIMATES from delayed options data. They are context, not signals.
// DECLUTTER: the "Stack zones" group shades areas where several different kinds of level pile up. In the Clean view (default) the
// levels inside a zone fold into it (hover the zone label for what is inside); key types (flips, walls, your levels) keep their line.
// Chart background: Auto reads your chart color; on a white chart light colors are drawn darker so everything stays visible.

const string G_GEN  = "General"
const string G_FLIP = "Gamma flip"
const string G_GEX  = "GEX"
const string G_OI   = "Open interest"
const string G_VOL  = "Volume"
const string G_MOVE = "Expected move"
const string G_CHARM = "Charm (estimate)"
const string G_VANNA = "Vanna (estimate)"
const string G_DEX  = "Dealer delta (estimate)"
const string G_NEW  = "New positions"
const string G_MINE = "Levels you typed in"
const string MAXTIP = "Draws only this many levels of this kind: the highest-scoring ones. 0 = draw every one you pasted."

levelsText = input.text_area("// price, label, type", "Levels (paste from the app)", group = G_GEN)
startMode  = input.string("Level time", "Lines start at", options = ["Level time", "Session open 9:30 ET", "Start of chart data"], group = G_GEN)
extBars    = input.int(3, "Lines run this many bars past the current candle", minval = 0, group = G_GEN)
offsetPts  = input.float(0.0, "Add to every level (points)", group = G_GEN)
maxDistPct = input.float(5.0, "Hide levels farther than this % from price", minval = 0.1, group = G_GEN)
showBlocks = input.bool(true, "Show the small block with the label", group = G_GEN)
blockSize  = input.string("small", "Block text size", options = ["tiny", "small", "normal"], group = G_GEN)
showBands  = input.bool(true, "Shade zone bands", group = G_GEN, inline = "band")
bandTransp = input.int(82, "Transparency", minval = 0, maxval = 100, group = G_GEN, inline = "band")
bandFarPct = input.float(1.0, "Zones farther than this % from price are drawn as a line", minval = 0.0, step = 0.1, tooltip = "Expected-move, call, put and GEX zones far from price lose their shaded band and show as one line at their main price. Distance is measured to the nearest edge of the zone. 0 = always a line.", group = G_GEN)

showFlip = input.bool(true, "Show", group = G_FLIP, inline = "flip")
cFlip    = input.color(#e6b422, "", group = G_FLIP, inline = "flip")
wFlip    = input.int(2, "Width", minval = 1, maxval = 6, group = G_FLIP, inline = "flip")
sFlip    = input.string("Solid", "Style", options = ["Solid", "Dashed", "Dotted"], group = G_FLIP, inline = "flip")

showGex  = input.bool(true, "Show", group = G_GEX, inline = "gex")
maxGex   = input.int(8, "Max levels", minval = 0, maxval = 60, tooltip = MAXTIP, group = G_GEX, inline = "gex")
wGex     = input.int(2, "Width", minval = 1, maxval = 6, group = G_GEX, inline = "gex2")
sGex     = input.string("Solid", "Style", options = ["Solid", "Dashed", "Dotted"], group = G_GEX, inline = "gex2")
cGexCall = input.color(#3fb96a, "Call wall", group = G_GEX, inline = "gexc")
cGexPut  = input.color(#e5534b, "Put wall", group = G_GEX, inline = "gexc")
cGexPos  = input.color(#2f8bf5, "+GEX", group = G_GEX, inline = "gexn")
cGexNeg  = input.color(#a371f7, "-GEX", group = G_GEX, inline = "gexn")
cGexConc = input.color(#2f8bf5, "GEX strike", group = G_GEX, inline = "gexn")
cGex0Call = input.color(#22d3ee, "0DTE call wall", group = G_GEX, inline = "gex0")
cGex0Put  = input.color(#ff4d8d, "0DTE put wall", group = G_GEX, inline = "gex0")
cGex0Flip = input.color(#ffd166, "0DTE flip", group = G_GEX, inline = "gex0")

showOi  = input.bool(true, "Show", group = G_OI, inline = "oi")
maxOi   = input.int(3, "Max levels", minval = 0, maxval = 60, tooltip = MAXTIP, group = G_OI, inline = "oi")
wOi     = input.int(1, "Width", minval = 1, maxval = 6, group = G_OI, inline = "oi2")
sOi     = input.string("Solid", "Style", options = ["Solid", "Dashed", "Dotted"], group = G_OI, inline = "oi2")
cOiCall = input.color(#ff9f43, "Call OI", group = G_OI, inline = "oic")
cOiPut  = input.color(#d9480f, "Put OI", group = G_OI, inline = "oic")
cOi     = input.color(#ff7a2e, "Other OI", group = G_OI, inline = "oic")

showVol  = input.bool(true, "Show", group = G_VOL, inline = "vol")
maxVol   = input.int(2, "Max levels", minval = 0, maxval = 60, tooltip = MAXTIP, group = G_VOL, inline = "vol")
wVol     = input.int(1, "Width", minval = 1, maxval = 6, group = G_VOL, inline = "vol2")
sVol     = input.string("Solid", "Style", options = ["Solid", "Dashed", "Dotted"], group = G_VOL, inline = "vol2")
cVolCall = input.color(#2ec4b6, "Call volume", group = G_VOL, inline = "volc")
cVolPut  = input.color(#f06292, "Put volume", group = G_VOL, inline = "volc")
cVol     = input.color(#3fb96a, "Other volume", group = G_VOL, inline = "volc")

showMove = input.bool(true, "Show", group = G_MOVE, inline = "mv")
maxMove  = input.int(4, "Max levels", minval = 0, maxval = 60, tooltip = MAXTIP, group = G_MOVE, inline = "mv")
wMove    = input.int(1, "Width", minval = 1, maxval = 6, group = G_MOVE, inline = "mv2")
sMove    = input.string("Dotted", "Style", options = ["Solid", "Dashed", "Dotted"], group = G_MOVE, inline = "mv2")
cMove    = input.color(#7db7ff, "Expected", group = G_MOVE, inline = "mvc")
cMoveExt = input.color(#8e9bff, "Extended", group = G_MOVE, inline = "mvc")

showCharm  = input.bool(true, "Show", group = G_CHARM, inline = "ch")
maxCharm   = input.int(2, "Max levels", minval = 0, maxval = 60, tooltip = MAXTIP, group = G_CHARM, inline = "ch")
wCharm     = input.int(1, "Width", minval = 1, maxval = 6, group = G_CHARM, inline = "ch2")
sCharm     = input.string("Dashed", "Style", options = ["Solid", "Dashed", "Dotted"], group = G_CHARM, inline = "ch2")
cCharmSell = input.color(#e76f51, "Dealers sell into close", group = G_CHARM, inline = "chc")
cCharmBuy  = input.color(#2a9d8f, "Dealers buy into close", group = G_CHARM, inline = "chc")

showVanna  = input.bool(true, "Show", group = G_VANNA, inline = "va")
maxVanna   = input.int(2, "Max levels", minval = 0, maxval = 60, tooltip = MAXTIP, group = G_VANNA, inline = "va")
wVanna     = input.int(1, "Width", minval = 1, maxval = 6, group = G_VANNA, inline = "va2")
sVanna     = input.string("Dashed", "Style", options = ["Solid", "Dashed", "Dotted"], group = G_VANNA, inline = "va2")
cVannaPos  = input.color(#c77dff, "Vanna +", group = G_VANNA, inline = "vac")
cVannaNeg  = input.color(#ffb703, "Vanna -", group = G_VANNA, inline = "vac")

showDex    = input.bool(true, "Show", group = G_DEX, inline = "dx")
maxDex     = input.int(2, "Max levels", minval = 0, maxval = 60, tooltip = MAXTIP, group = G_DEX, inline = "dx")
wDex       = input.int(1, "Width", minval = 1, maxval = 6, group = G_DEX, inline = "dx2")
sDex       = input.string("Dotted", "Style", options = ["Solid", "Dashed", "Dotted"], group = G_DEX, inline = "dx2")
cDexPos    = input.color(#4cc9f0, "Dealers long delta", group = G_DEX, inline = "dxc")
cDexNeg    = input.color(#f72585, "Dealers short delta", group = G_DEX, inline = "dxc")

showNew    = input.bool(true, "Show", group = G_NEW, inline = "nw")
maxNew     = input.int(3, "Max levels", minval = 0, maxval = 60, tooltip = MAXTIP, group = G_NEW, inline = "nw")
wNew       = input.int(2, "Width", minval = 1, maxval = 6, group = G_NEW, inline = "nw2")
sNew       = input.string("Solid", "Style", options = ["Solid", "Dashed", "Dotted"], group = G_NEW, inline = "nw2")
cNewCall   = input.color(#b5e48c, "New calls", group = G_NEW, inline = "nwc")
cNewPut    = input.color(#ff6b6b, "New puts", group = G_NEW, inline = "nwc")

showCustom = input.bool(true, "Show", group = G_MINE, inline = "mine")
cCustom    = input.color(#ffffff, "", group = G_MINE, inline = "mine")
wCustom    = input.int(2, "Width", minval = 1, maxval = 6, group = G_MINE, inline = "mine")
sCustom    = input.string("Solid", "Style", options = ["Solid", "Dashed", "Dotted"], group = G_MINE, inline = "mine")

const string G_ZONE = "Stack zones (declutter)"
const string G_COLS = "Colors"
viewMode = input.string("Clean: zones + key lines + lone levels", "View", options = ["Clean: zones + key lines + lone levels", "Minimal: zones + key lines only", "Zones + every line", "Every line, no zones"], tooltip = "Clean: shaded stack zones replace the levels inside them; key types and levels on their own keep their line. Minimal: only the zones and the key types. Zones + every line: everything. Every line, no zones: the old view.", group = G_ZONE)
keyCats  = input.string("gamma_flip,gex0_flip,gex0_call_wall,gex0_put_wall,gex_call_zone,gex_put_zone,custom", "Key types (always keep their line)", tooltip = "Comma list of level types (the third field of each pasted line). These keep their line even inside a stack zone.", group = G_ZONE)
zMin     = input.int(3, "Different kinds to make a zone", minval = 2, maxval = 10, group = G_ZONE, inline = "zn")
zHeavy   = input.int(5, "Heavy at", minval = 2, maxval = 10, group = G_ZONE, inline = "zn", tooltip = "A zone needs at least this many different kinds of level (GEX, OI, volume, move, charm...). At the heavy count it gets the heavy color.")
zDist    = input.float(0.0, "Join levels within (points, 0 = auto)", minval = 0.0, step = 0.25, tooltip = "Levels this close join one zone. Auto = 0.04% of price: about 10 NQ points, 2.5 ES points.", group = G_ZONE)
zMaxW    = input.float(0.0, "Widest zone (points, 0 = 4x the join distance)", minval = 0.0, step = 1.0, group = G_ZONE)
zPad     = input.float(2.0, "Pad each side (points)", minval = 0.0, step = 0.25, group = G_ZONE)
zCol     = input.color(#2f8bf5, "Stacked", group = G_ZONE, inline = "zc")
zColH    = input.color(#ff7a2e, "Heavy", group = G_ZONE, inline = "zc")
zTransp  = input.int(80, "Zone transparency", minval = 0, maxval = 100, group = G_ZONE)
zLabel   = input.bool(true, "Zone label", group = G_ZONE)
bgMode   = input.string("Auto", "Chart background", options = ["Auto", "Light (white)", "Dark"], tooltip = "Auto reads your chart background. On a light (white) chart, light colors (yellow, light blue, white...) are drawn darker in the same hue.", group = G_COLS)

onLight() =>
    bgMode == "Light (white)" ? true : bgMode == "Dark" ? false : 0.299 * color.r(chart.bg_color) + 0.587 * color.g(chart.bg_color) + 0.114 * color.b(chart.bg_color) > 140

// on a light chart, light colors are drawn darker in the same hue (greys become near black)
ink(color c) =>
    color out = c
    if onLight()
        cr = color.r(c)
        cg = color.g(c)
        cb = color.b(c)
        lum = 0.299 * cr + 0.587 * cg + 0.114 * cb
        if lum > 115
            if math.max(cr, math.max(cg, cb)) - math.min(cr, math.min(cg, cb)) < 40
                out := color.rgb(38, 42, 52, color.t(c))
            else
                k = 115 / lum
                out := color.rgb(cr * k, cg * k, cb * k, color.t(c))
    out

isKeyCat(string cat) =>
    str.contains("," + str.replace_all(keyCats, " ", "") + ",", "," + cat + ",")

// which settings group a level type belongs to
famOf(string cat) =>
    switch cat
        "gamma_flip" => "flip"
        "custom" => "mine"
        "gex_concentration" => "gex"
        "gex0_call_wall" => "gex"
        "gex0_put_wall" => "gex"
        "gex0_flip" => "gex"
        "gex_call_zone" => "gex"
        "gex_put_zone" => "gex"
        "gex_pos_zone" => "gex"
        "gex_neg_zone" => "gex"
        "open_interest" => "oi"
        "oi_by_expiry" => "oi"
        "oi_mid" => "oi"
        "oi_call_zone" => "oi"
        "oi_put_zone" => "oi"
        "volume" => "vol"
        "volume_by_expiry" => "vol"
        "volume_mid" => "vol"
        "volume_call_zone" => "vol"
        "volume_put_zone" => "vol"
        "expected_move" => "move"
        "expected_move_ext" => "move"
        "charm_sell_zone" => "charm"
        "charm_buy_zone" => "charm"
        "vanna_pos_zone" => "vanna"
        "vanna_neg_zone" => "vanna"
        "dex_pos_zone" => "dex"
        "dex_neg_zone" => "dex"
        "new_call_zone" => "new"
        "new_put_zone" => "new"
        => "other"

colorFor(string cat) =>
    switch cat
        "gamma_flip" => cFlip
        "gex_concentration" => cGexConc
        "gex0_call_wall" => cGex0Call
        "gex0_put_wall" => cGex0Put
        "gex0_flip" => cGex0Flip
        "gex_call_zone" => cGexCall
        "gex_put_zone" => cGexPut
        "gex_pos_zone" => cGexPos
        "gex_neg_zone" => cGexNeg
        "open_interest" => cOi
        "oi_by_expiry" => cOi
        "oi_mid" => cOi
        "oi_call_zone" => cOiCall
        "oi_put_zone" => cOiPut
        "volume" => cVol
        "volume_by_expiry" => cVol
        "volume_mid" => cVol
        "volume_call_zone" => cVolCall
        "volume_put_zone" => cVolPut
        "expected_move" => cMove
        "expected_move_ext" => cMoveExt
        "custom" => cCustom
        "charm_sell_zone" => cCharmSell
        "charm_buy_zone" => cCharmBuy
        "vanna_pos_zone" => cVannaPos
        "vanna_neg_zone" => cVannaNeg
        "dex_pos_zone" => cDexPos
        "dex_neg_zone" => cDexNeg
        "new_call_zone" => cNewCall
        "new_put_zone" => cNewPut
        => color.gray

showFor(string fam) =>
    switch fam
        "flip" => showFlip
        "gex" => showGex
        "oi" => showOi
        "vol" => showVol
        "move" => showMove
        "mine" => showCustom
        "charm" => showCharm
        "vanna" => showVanna
        "dex" => showDex
        "new" => showNew
        => true

maxFor(string fam) =>
    switch fam
        "gex" => maxGex
        "oi" => maxOi
        "vol" => maxVol
        "move" => maxMove
        "charm" => maxCharm
        "vanna" => maxVanna
        "dex" => maxDex
        "new" => maxNew
        => 0

widthFor(string fam) =>
    switch fam
        "flip" => wFlip
        "gex" => wGex
        "oi" => wOi
        "vol" => wVol
        "move" => wMove
        "mine" => wCustom
        "charm" => wCharm
        "vanna" => wVanna
        "dex" => wDex
        "new" => wNew
        => 1

styleFor(string fam) =>
    string s = switch fam
        "flip" => sFlip
        "gex" => sGex
        "oi" => sOi
        "vol" => sVol
        "move" => sMove
        "mine" => sCustom
        "charm" => sCharm
        "vanna" => sVanna
        "dex" => sDex
        "new" => sNew
        => "Solid"
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

textSize() =>
    switch blockSize
        "tiny" => size.tiny
        "normal" => size.normal
        => size.small

stampToTime(string body) =>
    int result = na
    parts = str.split(str.trim(body), " ")
    if array.size(parts) >= 2
        d = str.split(array.get(parts, 0), "-")
        h = str.split(array.get(parts, 1), ":")
        if array.size(d) == 3 and array.size(h) >= 2
            result := timestamp("America/New_York", int(str.tonumber(array.get(d, 0))), int(str.tonumber(array.get(d, 1))), int(str.tonumber(array.get(d, 2))), int(str.tonumber(array.get(h, 0))), int(str.tonumber(array.get(h, 1))), 0)
    result

parseStart(string txt) =>
    int result = na
    rows = str.split(txt, "\n")
    for row in rows
        t = str.trim(row)
        if str.startswith(t, "// @start") or str.startswith(t, "@start")
            result := stampToTime(str.replace(str.replace(t, "// @start", ""), "@start", ""))
    result

validFam(string f) =>
    f == "gex" or f == "oi" or f == "vol" or f == "move" or f == "flip" or f == "mine" or f == "charm" or f == "vanna" or f == "dex" or f == "new"

parseLevels(string txt) =>
    prices = array.new<float>()
    names = array.new<string>()
    cats = array.new<string>()
    starts = array.new<int>()
    lows = array.new<float>()
    highs = array.new<float>()
    scores = array.new<float>()
    fams = array.new<string>()
    rows = str.split(txt, "\n")
    for row in rows
        t = str.trim(row)
        if str.length(t) > 0 and not str.startswith(t, "//") and not str.startswith(t, "@")
            parts = str.split(t, ",")
            if array.size(parts) >= 2
                p = str.tonumber(str.trim(array.get(parts, 0)))
                if not na(p)
                    cat = array.size(parts) >= 3 ? str.trim(array.get(parts, 2)) : "other"
                    fam = array.size(parts) >= 8 ? str.trim(array.get(parts, 7)) : ""
                    array.push(prices, p)
                    array.push(names, str.trim(array.get(parts, 1)))
                    array.push(cats, cat)
                    array.push(starts, array.size(parts) >= 4 ? stampToTime(array.get(parts, 3)) : int(na))
                    array.push(lows, array.size(parts) >= 6 ? str.tonumber(str.trim(array.get(parts, 4))) : float(na))
                    array.push(highs, array.size(parts) >= 6 ? str.tonumber(str.trim(array.get(parts, 5))) : float(na))
                    array.push(scores, array.size(parts) >= 7 ? str.tonumber(str.trim(array.get(parts, 6))) : float(na))
                    array.push(fams, validFam(fam) ? fam : famOf(cat))
    [prices, names, cats, starts, lows, highs, scores, fams]

var line[]  lns = array.new<line>()
var label[] lbs = array.new<label>()
var box[]   bxs = array.new<box>()

if barstate.islast
    for l in lns
        line.delete(l)
    for b in lbs
        label.delete(b)
    for x in bxs
        box.delete(x)
    array.clear(lns)
    array.clear(lbs)
    array.clear(bxs)
    [prices, names, cats, starts, lows, highs, scores, fams] = parseLevels(levelsText)
    levelStart = parseStart(levelsText)
    sessionOpen = timestamp("America/New_York", year(time, "America/New_York"), month(time, "America/New_York"), dayofmonth(time, "America/New_York"), 9, 30, 0)
    firstBarTime = time[math.min(bar_index, 4999)]
    startAt = switch startMode
        "Session open 9:30 ET" => sessionOpen
        "Start of chart data" => firstBarTime
        => na(levelStart) ? sessionOpen : levelStart
    startX = math.min(startAt, time)
    endX = time + extBars * timeframe.in_seconds() * 1000
    n = array.size(prices)
    if n == 0
        array.push(lbs, label.new(time, close, "Options levels: open the indicator settings and paste your levels", xloc = xloc.bar_time, style = label.style_label_down, color = color.new(color.gray, 70), textcolor = color.white, size = size.small))
    else
        // pick, per family, the highest-scoring levels up to that family's Max levels
        keep = array.new<bool>(n, false)
        for fam in array.from("flip", "gex", "oi", "vol", "move", "charm", "vanna", "dex", "new", "mine", "other")
            if showFor(fam)
                idx = array.new<int>()
                keys = array.new<float>()
                for i = 0 to n - 1
                    if array.get(fams, i) == fam
                        distPct = math.abs(array.get(prices, i) + offsetPts - close) / close * 100
                        if distPct <= maxDistPct
                            sc = array.get(scores, i)
                            array.push(idx, i)
                            array.push(keys, (na(sc) ? 0.0 : sc) - distPct * 0.001)
                cnt = array.size(idx)
                if cnt > 0
                    ord = array.sort_indices(keys, order.descending)
                    lim = maxFor(fam) == 0 ? cnt : math.min(maxFor(fam), cnt)
                    for k = 0 to lim - 1
                        array.set(keep, array.get(idx, array.get(ord, k)), true)
        // stack zones: chain the kept levels that sit close together; a chain with enough different kinds becomes a shaded zone
        inZone = array.new<bool>(n, false)
        zonesOn = viewMode != "Every line, no zones"
        if zonesOn
            vi = array.new<int>()
            vp = array.new<float>()
            for i = 0 to n - 1
                if array.get(keep, i)
                    array.push(vi, i)
                    array.push(vp, array.get(prices, i))
            m = array.size(vi)
            if m > 0
                ord = array.sort_indices(vp, order.ascending)
                joinD = zDist > 0 ? zDist : close * 0.0004
                maxW = zMaxW > 0 ? zMaxW : joinD * 4
                cid = array.new<int>(m, 0)
                nc = 0
                lastP = 0.0
                firstP = 0.0
                for k = 0 to m - 1
                    pk = array.get(vp, array.get(ord, k))
                    if k == 0
                        firstP := pk
                    else if pk - lastP > joinD or pk - firstP > maxW
                        nc += 1
                        firstP := pk
                    array.set(cid, k, nc)
                    lastP := pk
                for z = 0 to nc
                    seen = array.new<string>()
                    zNames = array.new<string>()
                    lo = 1e12
                    hi = -1e12
                    for k = 0 to m - 1
                        if array.get(cid, k) == z
                            ii = array.get(vi, array.get(ord, k))
                            pz = array.get(prices, ii)
                            lo := math.min(lo, pz)
                            hi := math.max(hi, pz)
                            if not array.includes(seen, array.get(fams, ii))
                                array.push(seen, array.get(fams, ii))
                            if array.size(zNames) < 12
                                array.push(zNames, array.get(names, ii))
                    cnt = array.size(seen)
                    if cnt >= zMin
                        for k = 0 to m - 1
                            if array.get(cid, k) == z
                                array.set(inZone, array.get(vi, array.get(ord, k)), true)
                        zl = lo + offsetPts - zPad
                        zh = hi + offsetPts + zPad
                        heavy = cnt >= zHeavy
                        above = (zl + zh) / 2 > close
                        zc = ink(heavy ? zColH : zCol)
                        array.push(bxs, box.new(startX, zh, endX, zl, xloc = xloc.bar_time, border_color = color.new(zc, 30), border_width = heavy ? 2 : 1, bgcolor = color.new(zc, zTransp)))
                        if zLabel
                            ztxt = (heavy ? "HEAVY STACK " : "STACK ") + str.tostring(cnt) + " kinds" + (above ? " - resistance?" : " - support?")
                            ztip = "Stack zone " + str.tostring(zl, "#.##") + " to " + str.tostring(zh, "#.##") + ": " + str.tostring(cnt) + " different kinds of level. Inside: " + array.join(zNames, ", ") + ". More separate reasons at one price = more likely price reacts there. An estimate, not a signal."
                            array.push(lbs, label.new(endX, zh, ztxt, xloc = xloc.bar_time, style = label.style_label_lower_left, color = color.new(zc, 15), textcolor = color.white, size = textSize(), tooltip = ztip))
        for i = 0 to n - 1
            cat0 = array.get(cats, i)
            folded = viewMode == "Clean: zones + key lines + lone levels" and array.get(inZone, i) and not isKeyCat(cat0)
            hidden = viewMode == "Minimal: zones + key lines only" and not isKeyCat(cat0)
            if array.get(keep, i) and not folded and not hidden
                cat = array.get(cats, i)
                fam = array.get(fams, i)
                p = array.get(prices, i) + offsetPts
                ownStart = array.get(starts, i)
                startI = startMode == "Level time" ? (na(ownStart) ? startX : math.min(ownStart, time)) : startX
                isMinor = cat == "oi_mid" or cat == "volume_mid" or cat == "oi_by_expiry" or cat == "volume_by_expiry"
                c = isMinor ? color.new(ink(colorFor(cat)), 45) : ink(colorFor(cat))
                zLow = array.get(lows, i)
                zHigh = array.get(highs, i)
                isBand = not na(zLow) and not na(zHigh) and zHigh > zLow
                bandDistPct = isBand ? (close >= zLow + offsetPts and close <= zHigh + offsetPts ? 0.0 : math.min(math.abs(close - zLow - offsetPts), math.abs(close - zHigh - offsetPts)) / close * 100) : 0.0
                if showBands and isBand and bandDistPct <= bandFarPct
                    array.push(bxs, box.new(startI, zHigh + offsetPts, endX, zLow + offsetPts, xloc = xloc.bar_time, border_color = c, border_width = 1, bgcolor = color.new(c, bandTransp)))
                array.push(lns, line.new(startI, p, endX, p, xloc = xloc.bar_time, color = c, width = widthFor(fam), style = styleFor(fam)))
                if showBlocks
                    array.push(lbs, label.new(endX, p, array.get(names, i) + " " + str.tostring(p, "#.##"), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(c, 30), textcolor = color.white, size = textSize()))
