# ---------------------------------------------------------------------------------------------
# Data sources. The dashboard has a "Data source" dropdown; any source listed here that works is
# available in it. Each source keeps its own data and history.
#   cboe    = free delayed quotes, no account and no key needed
#   massive = Massive / Polygon, needs your key (and a paid options plan for the options chain)
# ---------------------------------------------------------------------------------------------
PROVIDERS=cboe,massive
DEFAULT_PROVIDER=cboe

# --- Cboe (free) ---
# Index options need a leading underscore: _NDX (maps to NQ), _SPX (maps to ES). ETFs: QQQ, SPY.
# Symbols to track. The Market overview tab shows the daily bias for ALL of them side by side. Add QQQ and SPY for NQ/QQQ/ES/SPY,
# and other tickers if you like (for example IWM, NVDA). Each symbol is one more download per cycle, so keep the list short.
# CBOE_UNDERLYINGS=_NDX,_SPX,QQQ,SPY
CBOE_UNDERLYINGS=_NDX,_SPX
# Refresh every N seconds (Cboe data is delayed and updates every few minutes; minimum 60).
POLL_SECONDS=120

# --- Massive / Polygon (your key) ---
# Paste your key after the = sign and save. Never share this file or its contents.
MASSIVE_API_KEY=YOUR_API_KEY_HERE
MASSIVE_BASE_URL=https://api.massive.com
# What your plan delivers for options: delayed (15 minutes) or realtime. It controls how freshness is judged.
MASSIVE_OPTIONS_PLAN=delayed
# ETFs: QQQ,SPY. Index options need the I: prefix: I:NDX,I:SPX
MASSIVE_UNDERLYINGS=QQQ,SPY
MASSIVE_POLL_SECONDS=60
MASSIVE_MAX_RPM=60

# --- Shared settings ---
# Only look at expirations up to this many days out, and strikes within this fraction of the price.
MAX_DTE=30
STRIKE_WINDOW=0.12

# Futures contracts you want levels mapped to (you type the price or basis into the dashboard).
NQ_CONTRACT=NQZ6
ES_CONTRACT=ESZ6

# --- Opening the dashboard on your phone (same Wi-Fi) ---
# 1. Set HOST=0.0.0.0 and choose a password of 8+ characters below. The app refuses to start if HOST is open but no password is set.
# 2. The first time Windows asks, allow Python through the firewall on PRIVATE networks only.
# 3. Start the app; it prints the phone address (like http://192.168.1.20:8000). Open it on the phone and sign in once.
# This uses plain http on your home Wi-Fi. Never forward this port on your router or use it on public Wi-Fi.
HOST=127.0.0.1
ACCESS_PASSWORD=
PORT=8000
DB_PATH=data/analytics.db
RETENTION_SNAPSHOTS=150
